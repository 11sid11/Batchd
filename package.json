{
  "name": "batchd",
  "version": "0.3.2",
  "private": true,
  "description": "Bulk-delete your X.com likes and replies. Ships as a Tampermonkey userscript and a Chrome Web Store extension from one source tree.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:pacing": "node --test test/pacing.test.js",
    "test:persist": "node --test test/persist.test.js",
    "test:failures": "node --test test/failures.test.js",
    "test:run": "node --test test/run.test.js",
    "test:selectors": "node --test test/selectors.test.js",
    "build": "node scripts/build.js",
    "build:userscript": "node scripts/build.js userscript",
    "build:extension": "node scripts/build.js extension",
    "icons": "node scripts/build-icons.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "sharp": "^0.35.2"
  }
}
